---
/** An article section whose heading is a stable, linkable anchor. */
interface Props {
  id: string;
  title: string;
  n?: number;
}
const { id, title, n } = Astro.props;
---

<section class="doc-section" aria-labelledby={id}>
  <div class="doc-section__head">
    {n !== undefined && <span class="doc-section__n" aria-hidden="true">{String(n).padStart(2, '0')}</span>}
    <h2 id={id}>
      {title}
      <a class="anchor" href={`#${id}`} aria-label={`Link to section: ${title}`}>#</a>
    </h2>
  </div>
  <slot />
</section>
