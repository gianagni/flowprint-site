---
import { product } from '../data/site';
---

<footer class="site-footer on-dark">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">flowprint <span>by {product.maker}</span></p>
      <p class="site-footer__meta">
        v{product.version} · {product.status}. Distributed directly to invited testers — not published to npm.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/docs">Documentation</a></li>
        <li><a href="/docs/quick-start">Quick Start</a></li>
        <li><a href="/docs/cli-reference">CLI Reference</a></li>
        <li><a href="/docs/limitations">Limitations</a></li>
        <li>
          <a class="ext" href={product.repoUrl} target="_blank" rel="noopener noreferrer"
            >Source on GitHub<span class="sr-only"> (opens in a new tab)</span></a
          >
        </li>
      </ul>
    </nav>
    <p class="site-footer__maker">An independent studio project by noulfan.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night);
    color: var(--on-dark);
    border-top: 1px solid var(--rule-dark);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px 40px;
    padding: 36px var(--gutter);
  }

  .site-footer__name {
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .site-footer__name span {
    font: italic 400 0.95rem var(--serif);
    color: var(--on-dark-muted);
    letter-spacing: 0;
  }

  .site-footer__meta,
  .site-footer__maker {
    margin: 6px 0 0;
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.6;
    color: var(--on-dark-muted);
  }

  .site-footer__maker {
    grid-column: 1 / -1;
    padding-top: 18px;
    border-top: 1px solid var(--rule-dark);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    font-size: 0.86rem;
    color: var(--on-dark-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--lime);
  }

  @media (max-width: 759px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
