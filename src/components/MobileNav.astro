---
/**
 * The one navigation drawer used on every page below 900px.
 * A native <dialog> opened with showModal() gives focus containment,
 * Escape-to-close, an inert background and focus return for free.
 */
import { product, docs, docGroups, normalizePath } from '../data/site';

const current = normalizePath(Astro.url.pathname);
---

<dialog id="site-drawer" class="drawer on-dark" aria-label="Site navigation">
  <div class="drawer__head">
    <a class="drawer__brand" href="/">flowprint <span>by {product.maker}</span></a>
    <button class="drawer__close" type="button" data-nav-close>
      <span>Close</span>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6"></path>
      </svg>
    </button>
  </div>

  <nav aria-label="Main (menu)">
    <ul class="drawer__primary">
      <li><a href="/#overview" aria-current={current === '/' ? 'page' : undefined}>Product</a></li>
      <li>
        <a href="/docs" aria-current={current.startsWith('/docs') ? 'page' : undefined}>Documentation</a>
      </li>
      <li>
        <a class="ext" href={product.repoUrl} target="_blank" rel="noopener noreferrer"
          >GitHub<span class="sr-only"> (opens in a new tab)</span></a
        >
      </li>
    </ul>
  </nav>

  <nav aria-label="Documentation (menu)" class="drawer__docs">
    {
      docGroups.map((group, gi) => (
        <div class="drawer__group">
          <p class="eyebrow">
            {String(gi + 1).padStart(2, '0')} / {group}
          </p>
          <ul>
            {docs
              .filter((d) => d.group === group)
              .map((d) => (
                <li>
                  <a href={d.href} aria-current={current === d.href ? 'page' : undefined}>
                    {d.title}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </nav>

  <p class="drawer__foot">v{product.version} · {product.status}</p>
</dialog>

<style>
  .drawer {
    width: min(360px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0 0 0 auto;
    padding: 0 0 24px;
    border: 0;
    border-left: 1px solid var(--rule-dark);
    background: var(--night);
    color: var(--on-dark);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .drawer::backdrop {
    background: rgb(10 9 18 / 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] {
      animation: drawer-in 0.2s ease-out;
    }
    @keyframes drawer-in {
      from {
        transform: translateX(24px);
        opacity: 0;
      }
    }
  }

  .drawer__head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 16px 0 20px;
    background: var(--night);
    border-bottom: 1px solid var(--rule-dark);
  }

  .drawer__brand {
    font-weight: 700;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .drawer__brand span {
    font: italic 400 0.95rem var(--serif);
    color: var(--on-dark-muted);
    letter-spacing: 0;
  }

  .drawer__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid var(--rule-dark);
    border-radius: 2px;
    background: transparent;
    color: var(--on-dark);
    font: 600 0.72rem/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer__primary {
    padding: 12px 12px 16px;
    border-bottom: 1px solid var(--rule-dark);
  }

  .drawer a:not(.drawer__brand) {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    text-decoration: none;
    border-radius: 2px;
  }

  .drawer__primary a {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .drawer a[aria-current='page'] {
    background: var(--lime);
    color: var(--ink);
  }

  .drawer__docs {
    padding: 8px 12px;
  }

  .drawer__group .eyebrow {
    margin: 16px 10px 6px;
    color: var(--on-dark-muted);
  }

  .drawer__docs a {
    color: var(--on-dark);
  }

  .drawer__foot {
    margin: 20px 22px 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--on-dark-muted);
  }
</style>
