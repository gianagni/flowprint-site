---
import BaseLayout from '../layouts/BaseLayout.astro';
import { docs } from '../data/site';
---

<BaseLayout title="Page not found — Flowprint" description="This page does not exist on the Flowprint site.">
  <main id="main" class="nf" tabindex="-1">
    <div class="nf__inner">
      <p class="eyebrow nf__code">404 · Outside the map</p>
      <h1>Page not found.</h1>
      <p class="nf__lead">
        <em>Some paths cannot be resolved.</em> This one does not exist on the Flowprint site — the link may be old or
        mistyped.
      </p>
      <div class="nf__cta">
        <a class="btn btn--ink" href="/docs">Documentation overview <span aria-hidden="true">→</span></a>
        <a class="btn btn--outline" href="/">Home</a>
      </div>
      <nav aria-label="Documentation pages" class="nf__docs">
        <p class="eyebrow">All documentation</p>
        <ul>
          {docs.map((d) => <li><a href={d.href}>{d.title}</a></li>)}
        </ul>
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .nf {
    display: grid;
    place-items: center;
    min-height: calc(100dvh - var(--header-h) - 160px);
    padding: 72px var(--gutter);
    outline: none;
  }

  .nf__inner {
    width: min(640px, 100%);
  }

  .nf__code {
    margin: 0 0 16px;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .nf__lead {
    margin: 18px 0 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .nf__lead em {
    display: block;
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--ink);
  }

  .nf__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .nf__docs {
    margin-top: 44px;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }

  .nf__docs .eyebrow {
    margin: 0 0 10px;
    color: var(--muted);
  }

  .nf__docs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nf__docs a {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    color: var(--ink);
    text-underline-offset: 3px;
  }
</style>
